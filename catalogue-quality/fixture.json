      "query": "Miles Davis Kind of Blue",
      "expected": { "artists": ["Miles Davis"], "titles": ["Kind of Blue"] }
    },
    {
      "id": "famous-rumours",
      "categories": ["famous_artist", "common_album"],
      "query": "Fleetwood Mac Rumours",
      "expected": { "artists": ["Fleetwood Mac"], "titles": ["Rumours"] }
    },
    {
      "id": "famous-random-access-memories",
