      "query": "Daft Punk Random Access Memories",
      "expected": {
        "artists": ["Daft Punk"],
        "titles": ["Random Access Memories"]
      }
    },
    {
      "id": "famous-back-to-black",
      "categories": ["famous_artist", "common_album"],
